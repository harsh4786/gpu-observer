-        set(CUDA_TARGET_ARCH "aarch64-linux")
+        set(CUDA_TARGET_ARCH_CANDIDATES "aarch64-linux" "sbsa-linux")
     elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|amd64")
